{
    "firestore": {
        "database": "(default)",
        "location": "asia-northeast1",
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "instagram-clone-lesson-6c0ae",
