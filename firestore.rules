rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function keysOnly(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validUserCreate(uid) {
      return isOwner(uid)
        && keysOnly([
          'uid', 'email', 'username', 'displayName', 'photoUrl', 'bio',
          'phoneNumber', 'postsCount', 'followersCount', 'followingCount',
          'isVerified', 'createdAt', 'appLanguageCode', 'appLanguageCountryCode'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.photoUrl is string
        && request.resource.data.bio is string
        && request.resource.data.postsCount is int
        && request.resource.data.followersCount is int
        && request.resource.data.followingCount is int
        && request.resource.data.isVerified is bool
        && request.resource.data.createdAt is timestamp
        && (
          request.resource.data.appLanguageCode == null
          || request.resource.data.appLanguageCode is string
        )
        && (
          request.resource.data.appLanguageCountryCode == null
          || request.resource.data.appLanguageCountryCode is string
        )
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 30
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio.size() <= 150;
    }

    function validOwnUserUpdate(uid) {
      return isOwner(uid)
        && changedOnly([
          'displayName',
          'username',
          'bio',
          'photoUrl',
          'phoneNumber',
          'appLanguageCode',
          'appLanguageCountryCode'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.isVerified == resource.data.isVerified
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.bio is string
        && request.resource.data.photoUrl is string
        && (
          request.resource.data.appLanguageCode == null
          || request.resource.data.appLanguageCode is string
        )
        && (
          request.resource.data.appLanguageCountryCode == null
          || request.resource.data.appLanguageCountryCode is string
        )
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 30
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio.size() <= 150;
    }

    function validOwnCounterUpdate(uid) {
      return isOwner(uid)
        && (
          (
            changedOnly(['postsCount'])
            && request.resource.data.postsCount is int
            && request.resource.data.postsCount >= 0
            && (
              request.resource.data.postsCount == resource.data.postsCount + 1
              || request.resource.data.postsCount == resource.data.postsCount - 1
            )
          )
          ||
          (
            changedOnly(['followingCount'])
            && request.resource.data.followingCount is int
            && request.resource.data.followingCount >= 0
            && (
              request.resource.data.followingCount == resource.data.followingCount + 1
              || request.resource.data.followingCount == resource.data.followingCount - 1
            )
          )
        );
    }

    function validFollowerCounterUpdate(uid) {
      return signedIn()
        && request.auth.uid != uid
        && changedOnly(['followersCount'])
        && request.resource.data.followersCount is int
        && request.resource.data.followersCount >= 0
        && (
          request.resource.data.followersCount == resource.data.followersCount + 1
          || request.resource.data.followersCount == resource.data.followersCount - 1
        );
    }

    function validPostCreate() {
      return signedIn()
        && keysOnly([
          'id', 'uid', 'username', 'userDisplayName', 'userPhotoUrl',
          'imageUrls', 'caption', 'location', 'likesCount', 'commentsCount',
          'likedBy', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id is string
        && request.resource.data.username is string
        && request.resource.data.userDisplayName is string
        && request.resource.data.userPhotoUrl is string
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() >= 1
        && request.resource.data.imageUrls.size() <= 10
        && request.resource.data.imageUrls[0] is string
        && request.resource.data.imageUrls[0].size() <= 2000
        && request.resource.data.caption is string
        && request.resource.data.location is string
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.caption.size() <= 2200
        && request.resource.data.location.size() <= 120;
    }

    function validPostOwnerUpdate() {
      return isOwner(resource.data.uid)
        && changedOnly(['caption', 'location'])
        && request.resource.data.caption is string
        && request.resource.data.location is string
        && request.resource.data.caption.size() <= 2200
        && request.resource.data.location.size() <= 120;
    }

    function validPostLikeUpdate() {
      return signedIn()
        && changedOnly(['likedBy', 'likesCount'])
        && request.resource.data.likedBy is list
        && request.resource.data.likesCount is int
        && request.resource.data.likesCount >= 0
        && (
          (
            !(request.auth.uid in resource.data.likedBy)
            && request.auth.uid in request.resource.data.likedBy
            && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1
            && request.resource.data.likesCount == resource.data.likesCount + 1
          )
          ||
          (
            request.auth.uid in resource.data.likedBy
            && !(request.auth.uid in request.resource.data.likedBy)
            && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1
            && request.resource.data.likesCount == resource.data.likesCount - 1
          )
        );
    }

    function validPostCommentCountUpdate() {
      return signedIn()
        && changedOnly(['commentsCount'])
        && request.resource.data.commentsCount is int
        && request.resource.data.commentsCount >= 0
        && (
          request.resource.data.commentsCount == resource.data.commentsCount + 1
          || request.resource.data.commentsCount == resource.data.commentsCount - 1
        );
    }

    function validCommentCreate() {
      return signedIn()
        && keysOnly([
          'id', 'uid', 'username', 'userPhotoUrl', 'text',
          'likesCount', 'likedBy', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id is string
        && request.resource.data.username is string
        && request.resource.data.userPhotoUrl is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.likesCount == 0
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() == 0
        && request.resource.data.createdAt is timestamp;
    }

    function validCommentLikeUpdate() {
      return signedIn()
        && changedOnly(['likedBy', 'likesCount'])
        && request.resource.data.likedBy is list
        && request.resource.data.likesCount is int
        && request.resource.data.likesCount >= 0
        && (
          (
            !(request.auth.uid in resource.data.likedBy)
            && request.auth.uid in request.resource.data.likedBy
            && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1
            && request.resource.data.likesCount == resource.data.likesCount + 1
          )
          ||
          (
            request.auth.uid in resource.data.likedBy
            && !(request.auth.uid in request.resource.data.likedBy)
            && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1
            && request.resource.data.likesCount == resource.data.likesCount - 1
          )
        );
    }

    function validNotificationCreate() {
      return signedIn()
        && keysOnly([
          'fromUid', 'fromUsername', 'fromPhotoUrl', 'type', 'postId',
          'postImageUrl', 'text', 'isRead', 'createdAt'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromUsername is string
        && request.resource.data.fromPhotoUrl is string
        && request.resource.data.type in ['like', 'comment', 'follow', 'mention', 'message', 'call', 'missedCall']
        && (
          request.resource.data.postImageUrl == null
          || (
            request.resource.data.postImageUrl is string
            && request.resource.data.postImageUrl.size() <= 2000
          )
        )
        && (
          request.resource.data.text == null
          || (
            request.resource.data.text is string
            && request.resource.data.text.size() <= 500
          )
        )
        && request.resource.data.isRead == false
        && request.resource.data.createdAt is timestamp;
    }

    function chatParticipants(chatId) {
      return getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function existingChatParticipants(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function isChatParticipant(chatId) {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    function isChatParticipantAfter(chatId) {
      return signedIn() && request.auth.uid in chatParticipants(chatId);
    }

    function isExistingChatParticipant(chatId) {
      return signedIn() && request.auth.uid in existingChatParticipants(chatId);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if validUserCreate(uid);
      allow update: if validOwnUserUpdate(uid)
        || validOwnCounterUpdate(uid)
        || validFollowerCounterUpdate(uid);
      allow delete: if false;
    }

    match /users/{uid}/followers/{followerId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == followerId
        && request.resource.data.uid == followerId
        && request.resource.data.createdAt is timestamp;
      allow delete: if signedIn() && request.auth.uid == followerId;
      allow update: if false;
    }

    match /users/{uid}/following/{followingId} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.uid == followingId
        && request.resource.data.createdAt is timestamp;
      allow delete: if isOwner(uid);
      allow update: if false;
    }

    match /users/{uid}/saved/{postId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && keysOnly(['postId', 'postOwnerId', 'createdAt'])
        && request.resource.data.postId == postId
        && request.resource.data.postOwnerId is string
        && request.resource.data.createdAt is timestamp;
      allow delete: if isOwner(uid);
      allow update: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if validPostCreate();
      allow update: if validPostOwnerUpdate()
        || validPostLikeUpdate()
        || validPostCommentCountUpdate();
      allow delete: if isOwner(resource.data.uid);
    }

    match /posts/{postId}/comments/{commentId} {
      allow read: if signedIn();
      allow create: if validCommentCreate();
      allow update: if validCommentLikeUpdate();
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.uid ||
            request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.uid);
    }

    match /notifications/{uid}/items/{itemId} {
      allow read: if isOwner(uid);
      allow create: if signedIn() && validNotificationCreate();
      allow update: if isOwner(uid) && changedOnly(['isRead']);
      allow delete: if isOwner(uid);
    }

    match /chats/{chatId} {
      allow read: if isChatParticipant(chatId);
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update: if isChatParticipant(chatId)
        && changedOnly(['participants', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'seenBy', 'typing'])
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;
    }

    match /chats/{chatId}/messages/{msgId} {
      allow read: if isExistingChatParticipant(chatId);
      allow create: if isChatParticipantAfter(chatId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.type in ['text', 'image']
        && request.resource.data.seen == false
        && request.resource.data.createdAt is timestamp;
      allow update: if isExistingChatParticipant(chatId) && changedOnly(['seen']);
      allow delete: if false;
    }

    match /calls/{callId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid ||
            resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.isVideo is bool
        && request.resource.data.status == 'calling'
        && request.resource.data.callerUsername is string
        && request.resource.data.callerDisplayName is string
        && request.resource.data.callerPhotoUrl is string
        && request.resource.data.callerUsername.size() <= 30
        && request.resource.data.callerDisplayName.size() <= 80
        && request.resource.data.callerPhotoUrl.size() <= 2000
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn()
        && (resource.data.fromUid == request.auth.uid ||
            resource.data.toUid == request.auth.uid)
        && changedOnly(['status'])
        && request.resource.data.status in ['calling', 'accepted', 'declined', 'ended', 'missed'];
      allow delete: if false;
    }

    match /app_translations/{localeId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
